{
  "mcp": {
    "shield-kya": {
      "type": "local",
      "command": ["npx", "--no-install", "@shield-agent/kya@0.1.36", "serve-mcp", "--stdio"],
      "enabled": true,
      "environment": {
        "KYA_BASE_URL": "https://shield-agent.com",
