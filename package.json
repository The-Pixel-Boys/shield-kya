{
  "name": "@shield-agent/kya",
  "version": "0.35.7",
  "description": "Stops your coding agent from deleting, leaking or dropping things. Records everything else.",
  "license": "MIT",
  "type": "module",
  "mcpName": "io.github.The-Pixel-Boys/shield-kya",
  "bin": {
    "kya": "./dist/cli.js",
    "shield-kya": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist",
    "catalog",
    "data",
    "vendor",
    "README.md",
    "server.json",
    "LICENSE",
    "LIMITATIONS.md",
    "mcp.json",
    "manifest.json",
    ".mcp.json",
    "claude",
    "assets",
    "skills",
    "rules",
    ".cursor-plugin",
    "openai",
    "gemini",
    "grok",
    "opencode",
    "kilo",
    "kiro",
    "qwen",
    "kimi",
    "mastracode",
    "amp",
    "copilot",
    "cline",
    "droid"
  ],
  "homepage": "https://shield-agent.com/install",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Pixel-Boys/shield-kya.git"
  },
  "bugs": {
    "url": "https://github.com/The-Pixel-Boys/shield-kya/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:check": "pnpm run build && pnpm pack --pack-destination /tmp && node dist/cli.js --help",
    "sync:version": "node scripts/sync-version.mjs",
    "check:version": "node scripts/check-version-pins.mjs",
    "sync:channel-copy": "node scripts/check-channel-copy.mjs --write",
    "check:channel-copy": "node scripts/check-channel-copy.mjs",
    "sync:replays": "node scripts/replays-scoreboard.mjs",
    "check:replays": "node scripts/replays-scoreboard.mjs --check",
    "sync:replay-pages": "node scripts/replay-pages.mjs",
    "check:replay-pages": "node scripts/replay-pages.mjs --check",
    "check:replay-links": "node scripts/check-replay-links.mjs",
    "new-rule": "node scripts/new-rule.mjs",
    "sync:features": "node scripts/sync-features.mjs",
    "check:features": "node scripts/sync-features.mjs --check",
    "prepublishOnly": "pnpm run check:version && pnpm run build && pnpm test",
    "build:guard": "node scripts/build-guard.mjs",
    "check:guard": "node scripts/build-guard.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.25.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "kya",
    "know-your-agent",
    "mcp",
    "policy",
    "shield-agent",
    "cli",
    "mcp-server",
    "ai-agents",
    "agent-observability",
    "audit-trail",
    "ai-act",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "grok",
    "kimi"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0"
  }
}
