{
  "__inputs": [
    {
      "name": "DS_TEMPO",
      "label": "Tempo",
      "description": "Tempo with TraceQL metrics enabled",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    },
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus or Mimir receiving OTLP metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.3.0"
    },
    {
      "type": "datasource",
      "id": "tempo",
      "name": "Tempo",
      "version": "1.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "bargauge",
      "name": "Bar gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": ""
    }
  ],
  "title": "Shield KYA verdicts (community)",
  "description": "Community dashboard over Shield KYA OTLP verdict spans (Tempo) and metrics (Prometheus). Source: the integrations/ folder of the public shield-kya repo, from the first release that includes it",
  "uid": "shield-kya-verdicts",
  "tags": [
    "shield-kya",
    "ai-agents",
    "otlp"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 42,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "service",
        "label": "CLI service (service.name / job)",
        "query": "shield-kya-cli",
        "current": {
          "text": "shield-kya-cli",
          "value": "shield-kya-cli"
        },
        "options": [
          {
            "selected": true,
            "text": "shield-kya-cli",
            "value": "shield-kya-cli"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "hosted_job",
        "label": "Hosted service (job)",
        "query": "shield-agent",
        "current": {
          "text": "shield-agent",
          "value": "shield-agent"
        },
        "options": [
          {
            "selected": true,
            "text": "shield-agent",
            "value": "shield-agent"
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "About this dashboard",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Community dashboard for Shield KYA, not an official Grafana integration. Verdict panels read the OSS verdict spans (service shield-kya-cli). Hook and wrap gates export only DENY and REQUIRE_APPROVE spans; only the long-lived MCP gate or gateway exports ALLOW, so the ALLOW share is undercounted for hook-only setups. Default hooks fail open without emitting anything; only opt-in fail-closed hooks emit FAIL_CLOSED. TraceQL panels need TraceQL metrics enabled in Tempo (local-blocks processor). Approval/hold latency and export failures are not emitted, so there are no panels for them. Panels marked (connected mode only) need a long-lived MCP gate or gateway connected to a hosted plane with KYA_OTLP_ENDPOINT set (hooks evaluate offline and short CLI runs exit before the 15 s metric export); panels marked (hosted only) need the hosted plane with KYA_OTLP_ENABLED=true."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DENY verdicts",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.verdict=\"DENY\"} | count_over_time()",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "REQUIRE_APPROVE verdicts (review)",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.verdict=\"REQUIRE_APPROVE\"} | count_over_time()",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Never-list hits (NEVER_EVENT)",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.reason_code=\"NEVER_EVENT\"} | count_over_time()",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Gate failures (plane unreachable, auth rejected, fail-closed)",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.reason_code=~\"PLANE_UNREACHABLE|PLANE_AUTH_REJECTED|FAIL_CLOSED\"} | count_over_time()",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Verdicts over time (ALLOW / REQUIRE_APPROVE / DENY)",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.verdict != nil} | count_over_time() by (span.kya.verdict)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top deny reasons",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.verdict=\"DENY\"} | count_over_time() by (span.kya.reason_code) | topk(10)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal"
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Tool calls by tool (top 10)",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.verdict != nil} | count_over_time() by (span.gen_ai.tool.name) | topk(10)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal"
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Verdicts by gate host (ide/runtime) and mode",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"$service\" && span.kya.verdict != nil} | count_over_time() by (span.kya.host, span.kya.mode, span.kya.verdict)",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Verdict mix from evaluate metric (connected mode only)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (verdict) (increase(kya_client_evaluate_latency_milliseconds_count{job=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{verdict}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Evaluate latency p50 / p95 ms (connected mode only)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(kya_client_evaluate_latency_milliseconds_bucket{job=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(kya_client_evaluate_latency_milliseconds_bucket{job=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Hosted verdict counters per interval (hosted only)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "delta(kya_policy_deny{job=\"$hosted_job\"}[$__rate_interval])",
          "legendFormat": "deny",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "delta(kya_policy_require_approve{job=\"$hosted_job\"}[$__rate_interval])",
          "legendFormat": "require_approve",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "delta(kya_policy_approve_granted{job=\"$hosted_job\"}[$__rate_interval])",
          "legendFormat": "approve_granted",
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "delta(kya_evaluate_count{job=\"$hosted_job\"}[$__rate_interval])",
          "legendFormat": "evaluate",
          "range": true
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Hosted evaluate latency avg and max ms (hosted only)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(kya_evaluate_latency_milliseconds_sum{job=\"$hosted_job\"}[$__rate_interval])) / sum(rate(kya_evaluate_latency_milliseconds_count{job=\"$hosted_job\"}[$__rate_interval]))",
          "legendFormat": "avg",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(kya_evaluate_max_ms{job=\"$hosted_job\"})",
          "legendFormat": "max",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Hosted kill latency vs SLO ms (hosted only)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(kya_kill_last_ms{job=\"$hosted_job\"})",
          "legendFormat": "last kill",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(kya_kill_slo_ms{job=\"$hosted_job\"})",
          "legendFormat": "SLO",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Hosted PII redaction hits, cumulative (hosted only)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "max(kya_redaction_hits{job=\"$hosted_job\"})",
          "legendFormat": "redaction hits",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
