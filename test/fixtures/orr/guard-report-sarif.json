{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "guard",
          "informationUri": "https://guard.org"
        }
      },
      "results": [
        {
          "ruleId": "guard.mcp.poisoning",
          "level": "error",
          "message": {
            "text": "Tool description poisoning detected on kya.policy_evaluate mirror"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "server.json"
                }
              }
            }
          ]
        },
        {
          "ruleId": "guard.guard.info",
          "level": "note",
          "message": {
            "text": "Baseline created for MCP config"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".mcp.json"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
