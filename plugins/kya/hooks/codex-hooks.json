{
  "description": "Shield KYA for Codex: install a pinned kya once per machine, then record every tool call (advisory, fails open). Codex runs these only after you trust them in /hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/bootstrap.mjs\" @shield-agent/kya@0.32.4",
            "timeout": 120,
            "statusMessage": "Shield KYA: checking the local kya install"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_DATA}/node_modules/@shield-agent/kya/dist/cli.js\" hook --host codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
