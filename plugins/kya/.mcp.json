{
  "mcpServers": {
    "shield-kya": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_DATA}/node_modules/@shield-agent/kya/dist/cli.js",
        "serve-mcp",
        "--stdio"
      ],
      "env": {
        "KYA_OFFLINE": "1",
        "KYA_HOST": "ide",
        "KYA_BASE_URL": "http://127.0.0.1:1",
        "KYA_API_KEY": ""
      }
    }
  }
}
