{
  "name": "shield-kya",
  "displayName": "Shield KYA",
  "description": "Audit trail and traceability for AI agents. See kya verdicts for every coding agent tool call in your editor. Advisory: kya records every call, blocks only the never-list, fails open.",
  "version": "0.1.0",
  "publisher": "shield-agent",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://shield-agent.com/install",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Pixel-Boys/shield-kya.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/The-Pixel-Boys/shield-kya/issues"
  },
  "qna": false,
  "categories": ["AI", "Other"],
  "keywords": ["kya", "ai agents", "audit trail", "mcp", "claude code", "cursor", "codex"],
  "engines": {
    "vscode": "^1.101.0"
  },
  "extensionKind": ["workspace"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the verdict feed is read-only: Shield KYA does not run kya, register the MCP server, connect the workspace or call the hosted plane.",
      "restrictedConfigurations": [
        "shieldKya.trailPath",
        "shieldKya.cliPath",
        "shieldKya.hosted.enabled",
        "shieldKya.hosted.baseUrl",
        "shieldKya.mcp.enabled"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "In virtual workspaces the verdict feed is read-only and no commands run."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "shieldKya", "title": "Shield KYA", "icon": "media/activity.svg" }
      ]
    },
    "views": {
      "shieldKya": [
        { "id": "shieldKya.feed", "name": "Verdicts" },
        { "id": "shieldKya.approvals", "name": "Hosted approvals" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "shieldKya.feed",
        "contents": "No kya trail rows yet. Install kya and wire your agent: `npm i -g @shield-agent/kya` then `kya start`.\n[Connect this workspace](command:shieldKya.connectWorkspace)\nkya is advisory: it records every tool call and blocks only the never-list."
      }
    ],
    "commands": [
      { "command": "shieldKya.refresh", "title": "Refresh feed", "category": "Shield KYA", "icon": "$(refresh)" },
      { "command": "shieldKya.connectWorkspace", "title": "Connect this workspace", "category": "Shield KYA", "enablement": "isWorkspaceTrusted && !virtualWorkspace" },
      { "command": "shieldKya.refreshApprovals", "title": "Refresh hosted approvals", "category": "Shield KYA", "icon": "$(refresh)", "enablement": "isWorkspaceTrusted && !virtualWorkspace" },
      { "command": "shieldKya.approve", "title": "Approve", "category": "Shield KYA", "icon": "$(check)", "enablement": "isWorkspaceTrusted && !virtualWorkspace" },
      { "command": "shieldKya.reject", "title": "Reject", "category": "Shield KYA", "icon": "$(close)", "enablement": "isWorkspaceTrusted && !virtualWorkspace" },
      { "command": "shieldKya.setApiKey", "title": "Set hosted API key", "category": "Shield KYA", "enablement": "isWorkspaceTrusted && !virtualWorkspace" },
      { "command": "shieldKya.clearApiKey", "title": "Clear hosted API key", "category": "Shield KYA" }
    ],
    "menus": {
      "view/title": [
        { "command": "shieldKya.refresh", "when": "view == shieldKya.feed", "group": "navigation" },
        { "command": "shieldKya.refreshApprovals", "when": "view == shieldKya.approvals", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "shieldKya.approve", "when": "view == shieldKya.approvals && viewItem == approval", "group": "inline" },
        { "command": "shieldKya.reject", "when": "view == shieldKya.approvals && viewItem == approval", "group": "inline" }
      ],
      "commandPalette": [
        { "command": "shieldKya.approve", "when": "false" },
        { "command": "shieldKya.reject", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Shield KYA",
      "properties": {
        "shieldKya.trailPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Trail file to show. Empty = ~/.kya/trail.jsonl (or $KYA_HOME/.kya/trail.jsonl). User settings only."
        },
        "shieldKya.cliPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to an installed kya (the bin or dist/cli.js). Empty = the first kya on PATH. Paths inside the open workspace are refused. User settings only."
        },
        "shieldKya.hosted.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "List and decide hosted approvals. Off = the extension makes no network calls. The key is stored with 'Shield KYA: Set hosted API key' in VS Code SecretStorage, never in settings."
        },
        "shieldKya.hosted.baseUrl": {
          "type": "string",
          "default": "https://shield-agent.com",
          "scope": "application",
          "description": "Hosted plane origin (https; http only for 127.0.0.1/localhost). User settings only."
        },
        "shieldKya.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Offer the installed kya as an MCP server (kya serve-mcp --stdio, offline evaluate) to the editor's agent, via the VS Code or Cursor MCP extension API. Trusted workspaces only."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      { "id": "shieldKya.mcp", "label": "Shield KYA" }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/core.test.cjs",
    "package": "tsc -p tsconfig.json && vsce package --no-dependencies --out dist/shield-kya.vsix",
    "e2e": "node e2e/run.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  }
}
