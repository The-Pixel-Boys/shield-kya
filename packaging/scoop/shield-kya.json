{
    "version": "0.25.0",
    "description": "Audit trail and traceability for AI agents. See what every coding agent did, with opt-in human approval and signed certify.",
    "homepage": "https://shield-agent.com/install",
    "license": "MIT",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-0.25.0.tgz",
    "hash": "sha256:eb4912ea989d38efd8aef81285b4345338194d1084dcac61d8f34fe919f32471",
    "extract_dir": "package",
    "pre_install": [
        "Set-Content -Path \"$dir\\kya.cmd\" -Value '@node \"%~dp0dist\\cli.js\" %*' -Encoding Ascii"
    ],
    "post_install": [
        "Push-Location \"$dir\"",
        "npm install --omit=dev --no-audit --no-fund",
        "$npmExit = $LASTEXITCODE",
        "Pop-Location",
        "if ($npmExit -ne 0) { throw \"npm install failed with exit code $npmExit\" }"
    ],
    "bin": [
        "kya.cmd",
        [
            "kya.cmd",
            "shield-kya"
        ]
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@shield-agent/kya",
        "jsonpath": "$.dist-tags.latest"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-$version.tgz"
    }
}
