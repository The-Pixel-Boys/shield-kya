{
    "version": "0.23.1",
    "description": "Audit trail and traceability for AI agents - local MCP gate (Allow/Review/Deny), live receipt dashboard, trust-baseline certification.",
    "homepage": "https://shield-agent.com/install",
    "license": "MIT",
    "depends": "nodejs",
    "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-0.23.1.tgz",
    "hash": "sha256:1bf71cdbe51d161597504b3ed64206e5686dd3a409a1d8d862f90d10fadbf986",
    "extract_dir": "package",
    "pre_install": [
        "Set-Content -Path \"$dir\\kya.cmd\" -Value '@node \"%~dp0dist\\cli.js\" %*' -Encoding Ascii"
    ],
    "post_install": [
        "Push-Location \"$dir\"",
        "npm install --omit=dev --no-audit --no-fund",
        "$npmExit = $LASTEXITCODE",
        "Pop-Location",
        "if ($npmExit -ne 0) { throw \"npm install failed with exit code $npmExit\" }"
    ],
    "bin": [
        "kya.cmd",
        [
            "kya.cmd",
            "shield-kya"
        ]
    ],
    "checkver": {
        "url": "https://registry.npmjs.org/@shield-agent/kya",
        "jsonpath": "$.dist-tags.latest"
    },
    "autoupdate": {
        "url": "https://registry.npmjs.org/@shield-agent/kya/-/kya-$version.tgz"
    }
}
